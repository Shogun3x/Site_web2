---
// Components
import { getFooterNavigationData } from '../../config/footerNavigation'
const { logo, footerAbout, footerColumns, copyright } = await getFooterNavigationData()
---

<footer class="lf-footer">
	<div class="shell">
		<div class="lf-footer-inner">
			<!-- Brand + about -->
			<div class="lf-footer-brand">
				{logo?.src && (
					<a href="/">
						<img src={logo.src} alt={logo.alt} width="120" height="40" class="lf-footer-logo" />
					</a>
				)}
				{footerAbout?.aboutText && (
					<p class="lf-footer-about">{footerAbout.aboutText}</p>
				)}
			</div>

			<!-- Nav columns -->
			{footerColumns?.map((column) => (
				<div>
					{column.title && <p class="lf-footer-col-title">{column.title}</p>}
					<ul class="lf-footer-links">
						{column.links?.map((link) => (
							<li><a href={link.href}>{link.label}</a></li>
						))}
					</ul>
				</div>
			))}
		</div>

		<!-- Copyright bar -->
		<div class="lf-footer-copy">
			<span>{copyright?.text}</span>
			{copyright?.legal?.length && (
				<div class="lf-footer-legal">
					{copyright.legal.map((l) => (
						<a href={l.href}>{l.label}</a>
					))}
				</div>
			)}
		</div>
	</div>
</footer>

<style>
	.lf-footer {
		border-top: 1px solid var(--lf-line);
		background: rgba(255, 253, 250, 0.7);
		margin-top: 0;
	}
	.lf-footer-inner {
		display: grid;
		grid-template-columns: 2fr 1fr 1fr;
		gap: 40px;
		padding: 40px 0 32px;
	}
	.lf-footer-brand {
		display: flex;
		flex-direction: column;
		gap: 14px;
	}
	.lf-footer-logo {
		height: 64px;
		width: auto;
		display: block;
	}
	.lf-footer-about {
		font-size: 0.9rem;
		color: var(--lf-muted);
		line-height: 1.6;
		margin: 0;
		max-width: 36ch;
	}
	.lf-footer-col-title {
		font-size: 12px;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--lf-ink);
		margin: 0 0 14px;
	}
	.lf-footer-links {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: 10px;
	}
	.lf-footer-links li { margin: 0; padding: 0; }
	.lf-footer-links a {
		font-size: 0.9rem;
		color: var(--lf-muted);
		text-decoration: none;
	}
	.lf-footer-links a:hover { color: var(--lf-ink); }
	.lf-footer-copy {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 16px;
		padding: 20px 0 28px;
		border-top: 1px solid var(--lf-line);
		font-size: 0.85rem;
		color: var(--lf-muted);
	}
	.lf-footer-legal {
		display: flex;
		gap: 20px;
	}
	.lf-footer-legal a {
		color: var(--lf-muted);
		text-decoration: none;
	}
	.lf-footer-legal a:hover { color: var(--lf-ink); }

	@media (max-width: 700px) {
		.lf-footer-inner {
			grid-template-columns: 1fr;
			gap: 28px;
		}
		.lf-footer-copy {
			flex-direction: column;
			align-items: flex-start;
		}
	}
</style>
