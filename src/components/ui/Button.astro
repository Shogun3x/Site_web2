---
// Button
// ------------
// Description: Interactive button element with various types, styles, and sizes.
// Properties:
// - Type: button type (link, button, submit, reset)
// - Size: button size (lg, base, sm)
// - Link: URL for link type buttons
// - Modal: ID of modal triggered by the button (optional)
// - Style: button style (neutral (default), primary, link)
// - Classes: additional CSS classes

// Content
// - Props
type Props = {
	type?: 'link' | 'button' | 'submit' | 'reset'
	size?: 'lg' | 'base' | 'sm'
	link?: string
	modal?: string
	style?: 'primary' | 'link' | 'neutral' | 'white' | 'warm'
	classes?: string
}
const { type = 'button', size = 'base', link, modal, style = 'primary', classes } = Astro.props

const isAbsoluteURL = (url: string) => /^https?:\/\//i.test(url)
---

{
	type === 'link' || link ? (
		<a
			href={link}
			target={link && isAbsoluteURL(link) ? '_blank' : '_self'}
			class:list={[
				'button',
				{ ['button--' + `${size}`]: size },
				{ ['button--' + `${style}`]: style },
				{ [`${classes}`]: classes }
			]}
		>
			<slot />
		</a>
	) : (
		<button
			type={type}
			class:list={[
				'button',
				{ ['button--' + `${size}`]: size },
				{ ['button--' + `${style}`]: style },
				{ [`${classes}`]: classes }
			]}
			{...(modal ? { 'data-modal': modal } : {})}
		>
			<slot />
		</button>
	)
}
<style>
	@reference '../../styles/global.css';
	.button {
		@apply relative inline-flex cursor-pointer items-center justify-center gap-2 rounded-full bg-neutral-950 font-medium text-nowrap text-white transition duration-300 hover:bg-neutral-800 focus-visible:outline-hidden disabled:cursor-not-allowed disabled:shadow-none;
	}
	.button--lg {
		@apply h-14 px-8;
	}
	.button--base {
		@apply h-12 px-8;
	}
	.button--sm {
		@apply h-10 px-4 text-sm;
	}
	.button--primary {
		@apply bg-neutral-950 text-white hover:bg-neutral-800;
	}
	.button--neutral {
		@apply bg-transparent border border-neutral-300 text-neutral-700 hover:border-neutral-500 hover:bg-neutral-100;
	}
	.button--white {
		@apply bg-white text-neutral-950 border border-neutral-300 hover:bg-neutral-100;
	}
	.button--link {
		@apply text-primary-500 hover:text-primary-600 inline-flex h-auto! items-center justify-start gap-2 border-0 bg-transparent px-0 rounded-none;
	}
	.button--warm {
		background: #d4c4aa !important;
		color: #2c1f14 !important;
		border: none;
		border-radius: 20px;
		font-weight: 600;
		letter-spacing: 0.025em;
		box-shadow:
			0px 2px 8px rgba(0, 0, 0, 0.12),
			0px 4px 16px rgba(122, 78, 45, 0.08),
			inset 0px 0px 0px 1px rgba(255, 255, 255, 0.3);
		transition: background 0.3s ease, box-shadow 0.3s ease;
	}
	.button--warm:hover {
		background: #ddd0ba !important;
		box-shadow:
			0px 3px 12px rgba(0, 0, 0, 0.15),
			0px 6px 20px rgba(122, 78, 45, 0.12),
			inset 0px 0px 0px 1px rgba(255, 255, 255, 0.4);
	}
	.button--warm:active {
		background: #c9b99a !important;
		box-shadow:
			0px 1px 4px rgba(0, 0, 0, 0.1),
			inset 0px 2px 4px rgba(0, 0, 0, 0.08);
		transform: none;
	}
	.button--warm:focus-visible {
		outline: 2px solid #b09978;
		outline-offset: 4px;
	}
</style>
